<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="200.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="ejemplog.proyectocarta_mg.SettingsController">
    <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" 
          AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <Label text="AJUSTES" style="-fx-font-weight: bold; -fx-font-size: 18;">
            <padding>
                <Insets bottom="10.0"/>
            </padding>
        </Label>
        
        <Label text="Volumen:"/>
        <Slider fx:id="volumeSlider" min="0" max="1" value="0.5" majorTickUnit="0.25" 
                showTickMarks="true" showTickLabels="true" prefWidth="300.0"/>
        
        <Button fx:id="btnApply" mnemonicParsing="false" text="Aplicar" prefWidth="100.0"/>
    </VBox>
</AnchorPane>