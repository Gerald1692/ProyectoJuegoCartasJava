<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="543.0" prefWidth="429.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ejemplog.proyectocarta_mg.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <ImageView fitHeight="284.0" fitWidth="374.0" pickOnBounds="true" smooth="false">
      <image>
         <Image url="@../../imagenes/frente.png" />
      </image>
   </ImageView>
     <Label text="Ingrese su nombre">
      <font>
         <Font name="Consolas" size="26.0" />
      </font>
   </Label>
   <TextArea fx:id="textonombre" prefHeight="55.0" prefWidth="601.0" />

    <!-- Contenedor para el campo de texto y botón -->
    <VBox alignment="CENTER" spacing="10.0" />
     <Button fx:id="BtnEntrar" mnemonicParsing="false" onAction="#switchToSecondary" prefHeight="58.0" prefWidth="172.0" text="Jugar">
      <font>
         <Font name="Comic Sans MS" size="18.0" />
      </font>
   </Button>
</VBox>
