<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="669.0" prefWidth="637.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ejemplog.proyectocarta_mg.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Contenedor para el campo de texto y botón -->
    <VBox alignment="CENTER" prefHeight="559.0" prefWidth="627.0" spacing="10.0">
      <Label prefHeight="57.0" prefWidth="403.0" text="Bienvenido">
         <font>
            <Font name="Engravers MT" size="48.0" />
         </font>
      </Label>
      <ImageView fitHeight="351.0" fitWidth="405.0" pickOnBounds="true" smooth="false">
         <image>
            <Image url="@frente.png" />
         </image>
      </ImageView>
        <Label prefHeight="16.0" prefWidth="204.0" text="Ingrese su nombre">
         <font>
            <Font name="Engravers MT" size="14.0" />
         </font></Label>
        <TextArea fx:id="txtNombre" editable="false" prefHeight="44.0" prefWidth="484.0" />
        <Button fx:id="BtnEntrar" mnemonicParsing="false" onAction="#switchToSecondary" prefHeight="50.0" prefWidth="129.0" text="Jugar">
         <font>
            <Font name="Engravers MT" size="14.0" />
         </font></Button>
    </VBox>
</VBox>
