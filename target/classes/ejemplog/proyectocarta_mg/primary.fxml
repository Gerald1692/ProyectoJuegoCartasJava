<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ejemplog.proyectocarta_mg.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título principal (centrado y con estilo) -->
    <Label text="Cerebros o Girasoles" textAlignment="CENTER">
        <font>
            <Font size="32.0" />
        </font>
    </Label>

    <!-- Mensaje de bienvenida -->
    <Label text="Bienvenido" />

    <!-- Contenedor para el campo de texto y botón -->
    <VBox alignment="CENTER" spacing="10.0">
        <Label text="Ingrese su nombre" />
        <TextArea prefWidth="200.0" prefHeight="44.0" />
        <Button fx:id="BtnEntrar" mnemonicParsing="false" onAction="#switchToSecondary" text="Jugar" />
    </VBox>
</VBox>